# Copy to .env and fill in. Keep comments on their own lines.
# python-dotenv can treat comments after empty values as values.

# openai_compat | google_genai
LLM_PROVIDER=openai_compat
# Set your Polza API key in .env. Do not commit it.
LLM_API_KEY=
LLM_BASE_URL=https://polza.ai/api/v1
# Empty for Polza; the reasoning switch is included in the model id below.
LLM_REASONING_EFFORT=

MODEL_CHEAP=deepseek/deepseek-v4.1-flash@reasoning_effort=none
MODEL_STRONG=deepseek/deepseek-v4.1-flash@reasoning_effort=none

# Optional observability; leave empty when unused.
# Manual runs save traces locally. Add --langfuse to upload to this host.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
